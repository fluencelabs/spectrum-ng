{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": {
    "enabled": true,
    "title": "Renovate Dashboard 🤖"
  },
  "commitMessagePrefix": "fix:",
  "semanticCommits": "enabled",
  "timezone": "UTC",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "flux": {
    "managerFilePatterns": ["/flux/.*\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/flux/.*\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/flux/.*\\.ya?ml$/"]
  },
  "kustomize": {
    "managerFilePatterns": ["/flux/.*\\.ya?ml$/"]
  },
  "github-actions": {
    "enabled": true,
    "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/", "/(^|/)action\\.ya?ml$/"]
  },
  "hostRules": [
    {
      "description": "Private zot registry (lightmare images and crd-operator chart); read-only user `renovate` on release/**",
      "matchHost": "containers.cloudless.dev",
      "hostType": "docker",
      "username": "renovate",
      "password": "{{ secrets.ZOT_RENOVATE_PASSWORD }}"
    }
  ],
  "customManagers": [
    {
      "description": "Update FluxInstance distribution version",
      "customType": "regex",
      "managerFilePatterns": ["/flux/.*\\.ya?ml$/"],
      "matchStrings": [
        "apiVersion: fluxcd\\.controlplane\\.io/v1\\s+kind: FluxInstance[\\s\\S]*?distribution:\\s*\\n[\\s]*version: [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "fluxcd/flux2",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "Update Flux Operator manifests artifact",
      "customType": "regex",
      "managerFilePatterns": ["/flux/.*\\.ya?ml$/"],
      "matchStrings": [
        "artifact: [\"']?oci://ghcr\\.io/controlplaneio-fluxcd/flux-operator-manifests:(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/controlplaneio-fluxcd/flux-operator-manifests"
    },
    {
      "description": "Update Flux components versions",
      "customType": "regex",
      "managerFilePatterns": ["/flux/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*?version: (?<currentValue>.*)\\s"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "fluxcd/{{{depName}}}"
    },
    {
      "description": "Update the KubeVirt and CDI operator manifests, pulled by release URL in kustomization resources (no built-in manager reads such a URL)",
      "customType": "regex",
      "managerFilePatterns": ["/flux/apps/kubevirt/.+/kustomization\\.ya?ml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>kubevirt/(?:kubevirt|containerized-data-importer))/releases/download/(?<currentValue>v[^/\\s]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "enabled": true,
      "pinDigests": false
    },
    {
      "description": "Group Flux Operator updates",
      "matchPackageNames": ["/^fluxcd//", "/flux-operator/"],
      "matchDatasources": ["github-releases", "docker"],
      "groupName": "flux-operator",
      "automerge": false,
      "prPriority": 10
    },
    {
      "description": "Group lightmare components: the crd-* images and the crd-operator chart ship as one release, and the chart carries the CRDs (crds: CreateReplace), so an image bumped without its chart runs against the old schema",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^containers\\.cloudless\\.dev/release/crd-/"],
      "groupName": "lightmare",
      "commitMessagePrefix": "fix(crd-operator):",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "description": "KubeVirt and CDI upgrade only N-1 -> N between minors: one PR per minor, so a minor is never skipped",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["kubevirt/kubevirt", "kubevirt/containerized-data-importer"],
      "separateMultipleMinor": true,
      "automerge": false
    },
    {
      "description": "kube-ovn: the patch line and the next minor as separate PRs, so a patch lands without the minor's breaking changes",
      "matchPackageNames": ["kube-ovn-v2"],
      "separateMinorPatch": true,
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "commitMessagePrefix": "chore(ci):",
      "automerge": false,
      "prPriority": 5
    },
    {
      "description": "Separate major updates",
      "matchUpdateTypes": ["major"],
      "prPriority": 15,
      "labels": ["major-update"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
